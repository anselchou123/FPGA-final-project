`timescale 1ns / 1ps

module tb_mac;
    reg clk, rst_n, start;
    reg signed [7:0] a, b;
    wire signed [17:0] acc;

    // 實例化模組
    mac_accelerator uut (
        .clk(clk), .rst_n(rst_n), .start(start), 
        .a(a), .b(b), .acc(acc)
    );

    // 時鐘產生器
    always #5 clk = ~clk;

    initial begin
        // 初始化
        clk = 0; rst_n = 0; start = 0; a = 0; b = 0;
        #20 rst_n = 1;

        // 開始測試
        @(posedge clk);
        start = 1; a = 8'd2; b = 8'd3; // 2 * 3 = 6
        
        @(posedge clk);
        a = 8'd5; b = 8'd4;           // 5 * 4 = 20, 累加 6 + 20 = 26
        
        #20 $finish;
    end
endmodule
